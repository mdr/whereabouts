{
  "name": "whereabouts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./packages/client --filter ./packages/server dev",
    "build": "pnpm -r build",
    "test": "pnpm css-types && vp test run",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter ./packages/client smoke",
    "lint": "pnpm css-types && vp lint",
    "lint:fix": "pnpm css-types && vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "pnpm css-types && knip",
    "check": "pnpm css-types && vp check && knip && vp test run && pnpm --filter ./packages/client exec vp build",
    "css-types": "pnpm --filter ./packages/client css-types"
  },
  "devDependencies": {
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.38.0",
    "monocart-coverage-reports": "^3.2.0",
    "oxlint-plugin-eslint": "1.87.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest-monocart-coverage": "^5.0.0"
  }
}
