{
  "name": "whereabouts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./packages/client --filter ./packages/server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter ./packages/client smoke",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.70.1",
    "vitest": "^5.0.0"
  }
}
