{
  "name": "whereabouts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./packages/client --filter ./packages/server dev",
    "build": "pnpm -r build",
    "test": "vp test run",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter ./packages/client smoke",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "knip",
    "check": "vp check && knip && vp test run"
  },
  "devDependencies": {
    "knip": "^6.38.0",
    "oxlint-plugin-eslint": "1.87.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
