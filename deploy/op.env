# Where the Fly deploy token lives in 1Password. scripts/fly.sh resolves it
# for a single fly command; nothing secret is stored here, only a reference.
# Point it at wherever you keep the token that scripts/fly-bootstrap.sh
# printed. The account is chosen in scripts/fly.sh, since op reads
# OP_ACCOUNT from its own environment rather than from this file.
FLY_API_TOKEN="op://Private/Fly whereabouts deploy token/credential"
