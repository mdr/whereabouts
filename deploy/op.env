# Environment for local Fly commands, resolved by the 1Password CLI:
#
#   op run --env-file=deploy/op.env -- fly status
#   op run --env-file=deploy/op.env -- fly logs
#   op run --env-file=deploy/op.env -- fly deploy --image registry.fly.io/whereabouts-game:<git sha>
#
# Nothing secret lives here, only a reference. Point it at wherever you keep
# the deploy token that scripts/fly-bootstrap.sh printed.
FLY_API_TOKEN="op://Private/Fly whereabouts deploy token/credential"
