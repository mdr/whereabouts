          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(whereabouts_players_per_game_bucket{app=\"whereabouts-game\"}[$__rate_interval])))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(whereabouts_players_per_game_bucket{app=\"whereabouts-game\"}[$__rate_interval])))",
          "legendFormat": "90th percentile",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
