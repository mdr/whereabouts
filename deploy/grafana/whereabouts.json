          },
          "expr": "sum by (kind) (increase(whereabouts_client_errors_total{app=\"whereabouts-game\"}[1h]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (limit) (increase(whereabouts_client_errors_dropped_total{app=\"whereabouts-game\"}[1h]))",
          "legendFormat": "dropped from the log ({{limit}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
