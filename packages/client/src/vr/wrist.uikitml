<style>
  .root {
    flex-direction: column;
    width: 300px;
    padding: 14px;
    render-order: 10;
  }
  .heading {
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
    color: #94a3b8;
  }
  .section {
    margin-top: 12px;
  }
  .row {
    flex-direction: row;
    margin-top: 8px;
  }
  .gap {
    margin-left: 8px;
  }
  .note {
    margin-top: 4px;
    font-size: 15px;
    line-height: 20px;
    color: #67e8f9;
  }
  .help {
    margin-top: 12px;
    font-size: 12px;
    line-height: 16px;
    color: #cfd8e3;
  }
</style>
<Panel class="root">
  <span class="heading">PAINT TOOLS</span>
  <div class="row">
    <Button id="undo" variant="secondary">
      <ButtonIcon><Undo></Undo></ButtonIcon>
      Undo
    </Button>
    <Button id="redo" class="gap" variant="secondary">
      <ButtonIcon><Redo></Redo></ButtonIcon>
      Redo
    </Button>
  </div>
  <div class="row">
    <Button id="trim" variant="secondary">
      <ButtonIcon><Scissors></Scissors></ButtonIcon>
      <span id="trimLabel">Trim sea</span>
    </Button>
    <Button id="trimHint" class="gap" variant="secondary">
      <ButtonIcon><Lightbulb></Lightbulb></ButtonIcon>
      Trim to hint
    </Button>
  </div>
  <div class="row">
    <Button id="swap" variant="secondary">
      <ButtonIcon><ArrowLeftRight></ArrowLeftRight></ButtonIcon>
      Swap hands
    </Button>
    <Button id="clear" class="gap" variant="negative">
      <ButtonIcon><Trash2></Trash2></ButtonIcon>
      Clear
    </Button>
  </div>
  <span class="heading section">HINT</span>
  <span id="note" class="note">A band the answer lies in</span>
  <div id="hints" class="row">
    <Button id="latitude" variant="secondary">
      <ButtonIcon><MoveVertical></MoveVertical></ButtonIcon>
      Latitude
    </Button>
    <Button id="longitude" class="gap" variant="secondary">
      <ButtonIcon><MoveHorizontal></MoveHorizontal></ButtonIcon>
      Longitude
    </Button>
  </div>
  <span class="help">Trigger: right hand paints, left erases; A or X swaps that hand's tool. Nearer the globe for a small dense spot. Grip turns the globe, both grips zoom. Grip the picture to hold it.</span>
</Panel>
