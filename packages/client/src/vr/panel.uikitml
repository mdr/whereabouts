<style>
  .root {
    flex-direction: column;
    width: 420px;
    padding: 20px;
  }
  .heading {
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
    color: #94a3b8;
    margin-bottom: 2px;
  }
  .prompt {
    font-size: 26px;
    font-weight: 700;
    line-height: 32px;
    color: #f0fdff;
  }
  .score {
    margin-top: 6px;
    font-size: 20px;
    line-height: 26px;
    color: #67e8f9;
  }
  .hint {
    margin-top: 8px;
    font-size: 14px;
    line-height: 19px;
    color: #cfd8e3;
  }
  .row {
    flex-direction: row;
    margin-top: 14px;
  }
  .clock {
    margin-top: 4px;
    font-size: 18px;
    line-height: 24px;
    color: #fbbf24;
  }
  .fact {
    margin-top: 8px;
    font-size: 15px;
    line-height: 20px;
    color: #cfd8e3;
  }
  .note {
    margin-top: 8px;
    font-size: 15px;
    line-height: 20px;
    color: #f0fdff;
  }
  .gap {
    margin-left: 8px;
  }
</style>
<Panel class="root">
  <span id="heading" class="heading">THIS ROUND</span>
  <span id="prompt" class="prompt">-</span>
  <span id="clock" class="clock">-</span>
  <span id="score" class="score">-</span>
  <span id="fact" class="fact">-</span>
  <span id="note" class="note">-</span>
  <span id="hint" class="hint">Turn your left palm up for paint tools and hints.</span>
  <div class="row">
    <Button id="done" variant="positive">
      <ButtonIcon><Check></Check></ButtonIcon>
      <span id="doneLabel">Submit</span>
    </Button>
    <Button id="unlock" variant="secondary">
      <ButtonIcon><Pencil></Pencil></ButtonIcon>
      Keep editing
    </Button>
    <Button id="act0" variant="positive">
      <ButtonIcon><ArrowRight></ArrowRight></ButtonIcon>
      <span id="act0Label">Next</span>
    </Button>
    <Button id="act1" class="gap" variant="secondary">
      <ButtonIcon><ArrowRight></ArrowRight></ButtonIcon>
      <span id="act1Label">Next</span>
    </Button>
    <Button id="exit" class="gap" variant="tertiary">
      <ButtonIcon><LogOut></LogOut></ButtonIcon>
      Leave VR
    </Button>
  </div>
  <div id="extras" class="row">
    <Button id="flags" variant="secondary">
      <ButtonIcon><Flag></Flag></ButtonIcon>
      <span id="flagsLabel">Show all flags</span>
    </Button>
  </div>
  <div id="modes" class="row">
    <Button id="passthrough" variant="tertiary">
      <ButtonIcon><Eye></Eye></ButtonIcon>
      <span id="passthroughLabel">See your room</span>
    </Button>
  </div>
</Panel>
