{
  "name": "@whereabouts/client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "node scripts/css-module-types.ts && tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "node scripts/css-module-types.ts && tsc --noEmit && tsc --noEmit -p browser",
    "smoke": "playwright test -c browser/playwright.iwft.config.ts solo",
    "iwft": "playwright test -c browser/playwright.iwft.config.ts",
    "e2e": "playwright test -c browser/playwright.e2e.config.ts",
    "e2e:prod": "playwright test -c browser/playwright.prod.config.ts",
    "screenshots": "playwright test -c browser/playwright.screenshot.config.ts",
    "voiceover": "playwright test -c browser/playwright.voiceover.config.ts",
    "css-types": "node scripts/css-module-types.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@preact/signals": "^2.0.0",
    "@rivalis/browser": "^8.0.0",
    "@toolcase/base": "3.x",
    "@toolcase/logging": "3.x",
    "@whereabouts/shared": "workspace:*",
    "lucide-preact": "^1.47.0",
    "maplibre-gl": "^6.7.0",
    "preact": "^10.27.0",
    "three": "npm:super-three@0.181.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@guidepup/guidepup": "0.40.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/preact": "^3.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@types/three": "0.181.0",
    "@types/webxr": "0.5.24",
    "happy-dom": "^20.0.0",
    "iwer": "^2.7.0",
    "lightningcss": "^1.33.0",
    "monocart-coverage-reports": "^3.2.0",
    "svgo": "^4.1.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
