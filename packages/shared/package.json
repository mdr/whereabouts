{
  "name": "@whereabouts/shared",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./catalogue.json": "./catalogue.json",
    "./outlines.json": "./outlines.json",
    "./land.json": "./land.json",
    "./water.json": "./water.json",
    "./borders.json": "./borders.json",
    "./facts.json": "./facts.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "calibrate": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/calibrate-regions.mjs"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "polygon-clipping": "^0.15.7"
  }
}
