{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["nix"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["vitest-monocart-coverage", "@vitest/coverage-custom"]
    },
    "packages/client": {
      "entry": ["scripts/*.ts", "browser/**/*.{iwft,e2e,screenshot}.ts", "browser/coverage/global-coverage.ts"],
      "ignoreDependencies": ["iwer"],
      "playwright": {
        "config": [
          "browser/playwright.iwft.config.ts",
          "browser/playwright.e2e.config.ts",
          "browser/playwright.prod.config.ts",
          "browser/playwright.screenshot.config.ts"
        ]
      }
    },
    "packages/shared": { "entry": ["scripts/*.ts"] },
    "packages/server": {
      "entry": ["scripts/load/load-test.ts", "scripts/load/server-probe.ts", "src/**/*.iwbt.ts"],
      "ignore": ["src/vendor/**"]
    }
  }
}
