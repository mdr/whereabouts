{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/client": {
      "entry": ["scripts/*.mjs", "browser/e2e/*.ts"],
      "ignoreDependencies": ["flag-icons"]
    },
    "packages/shared": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/server": {
      "ignore": ["src/vendor/**"]
    }
  }
}
