{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["nix"],
  "workspaces": {
    "packages/client": {
      "entry": ["scripts/*.mjs", "browser/**/*.{iwft,e2e}.ts"],
      "ignore": ["scripts/*.d.mts"],
      "ignoreDependencies": ["iwer"],
      "playwright": { "config": ["playwright.config.ts", "playwright.prod.config.ts"] }
    },
    "packages/shared": { "entry": ["scripts/*.mjs"] },
    "packages/server": {
      "entry": ["scripts/load/load-test.ts", "scripts/load/server-probe.ts"],
      "ignore": ["src/vendor/**"]
    }
  }
}
