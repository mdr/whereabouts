{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["nix"],
  "workspaces": {
    "packages/client": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["iwer"],
      "playwright": {
        "config": ["playwright.config.ts", "playwright.prod.config.ts"]
      }
    },
    "packages/shared": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/server": {
      "ignore": ["src/vendor/**"]
    }
  }
}
